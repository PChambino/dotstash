#!/usr/bin/osascript -l JavaScript
// Drive Dia through its AppleScript dictionary (Dia.app/Contents/Resources/Dia.sdef).

const usage = `usage: dia [-p <profile>] list
       dia [-p <profile>] activate <match>
       dia [-p <profile>] open <url>
       dia [-p <profile>] eval <match> <js>

<match> is a tab id prefix, or text in its url or title
list prints profile, id, flags (P pinned, * focused), title, url`

ObjC.import('Foundation')
ObjC.import('stdlib')

function run(argv) {
  try {
    return main(argv)
  } catch (err) {
    const msg = $.NSString.alloc.initWithUTF8String(`${err.message.replace(/^(?!usage)/, 'dia: ')}\n`)
    $.NSFileHandle.fileHandleWithStandardError.writeData(msg.dataUsingEncoding($.NSUTF8StringEncoding))
    $.exit(err.message.startsWith('usage') ? 2 : 1)
  }
}

function main(argv) {
  let profileName
  if (argv[0] === '-p') {
    profileName = argv[1]
    argv = argv.slice(2)
  }
  const [cmd, ...args] = argv
  const need = { list: 0, activate: 1, open: 1, eval: 2 }[cmd]
  if (need === undefined || args.length < need) throw new Error(usage)

  const dia = Application('Dia')
  const win = dia.windows[0]
  const profiles = () => {
    const all = win.profiles()
    if (!profileName) return all
    const p = all.find(p => p.name().toLowerCase() === profileName.toLowerCase())
    if (!p) throw new Error(`no profile ${profileName}, have ${win.profiles.name().join(', ')}`)
    return [p]
  }
  const tabs = () =>
    profiles().flatMap(p => {
      const name = p.name()
      const t = p.tabs
      const [ids, titles, urls, pinned, focused] = [t.id(), t.title(), t.url(), t.ispinned(), t.isfocused()]
      return ids.map((id, i) => ({ profile: p, name, id, title: titles[i], url: urls[i], pinned: pinned[i], focused: focused[i], i }))
    })
  const find = match => {
    const all = tabs()
    const m = match.toLowerCase()
    const tab =
      all.find(t => t.id.toLowerCase().startsWith(m)) ??
      all.find(t => t.url.toLowerCase().includes(m) || t.title.toLowerCase().includes(m))
    if (!tab) throw new Error(`no tab matching ${match}`)
    return tab
  }

  if (cmd === 'list') {
    return tabs()
      .map(t => [t.name, t.id.slice(0, 8), (t.pinned ? 'P' : '') + (t.focused ? '*' : ''), t.title, t.url].join('\t'))
      .join('\n')
  }
  if (cmd === 'activate') {
    const t = find(args[0])
    dia.focus(t.profile.tabs[t.i])
    return t.title
  }
  if (cmd === 'open') {
    const url = /^[a-z][a-z0-9+.-]*:/i.test(args[0]) ? args[0] : `https://${args[0]}`
    const profile = profileName ? profiles()[0] : win.activeProfile
    const tab = dia.Tab({ url })
    profile.tabs.push(tab)
    return tab.id().slice(0, 8)
  }
  // AppleScript's `execute` needs a Dia launch flag; CDP's toggle survives restarts.
  if (cmd === 'eval') {
    const app = Application.currentApplication()
    app.includeStandardAdditions = true
    const q = s => `'${s.replace(/'/g, `'\\''`)}'`
    return app.doShellScript(`PATH=$HOME/.local/bin:/opt/homebrew/bin:$PATH dia-cdp eval ${q(find(args[0]).url)} ${q(args.slice(1).join(' '))}`).replace(/\r/g, '\n')
  }
}
