#!/bin/sh
# tmux window indicators for the Claude sessions running inside them.
#   1:carwow-airflow 2:carwow-terraflake▪ 4:.dotstash▪▪
#
# One mark per session from claude-sessions, coloured by that session's status.
# Named colours rather than cctop's hexes, so a mark is the same colour as the
# same status in cs, and so terminal-overrides' *:RGB cannot come into it.
#
# Run for its side effects from status-right's #(): it sets @claude_status per
# window, and window-status-format reads it back. Options set while a format is
# expanding land one redraw late, hence the trailing refresh-client; that redraw
# reuses the cached #() output, so it can't loop.

set -u

tab=$(printf '\t')

# The one colour table, shared by the marks below and --colours.
palette='working #[default]
compacting #[fg=cyan]
idle #[fg=white]
waiting_input #[fg=yellow]
waiting_permission #[fg=red]
error #[fg=red]'

# working keeps #[default] so the mark stays legible on the current window,
# whose style is bg=green: an explicit green there would be green on green.
if [ "${1:-}" = --colours ]; then
    printf '%s\n' "$palette" | awk '
        BEGIN {
            esc = sprintf("%c", 27); off = esc "[0m"
            n = split("green 32 cyan 36 white 37 yellow 33 red 31", a, " ")
            for (i = 1; i < n; i += 2) sgr[a[i]] = a[i + 1]
            print "tmux window marks"
        }
        $2 == "#[default]" {
            printf "  %s  %-19s %-14s %s\n", "▪▪▪", $1, $2, "status bar fg"
            next
        }
        {
            name = substr($2, 6, length($2) - 6)
            printf "  %s▪▪▪%s  %-19s %-14s SGR %s\n",
                esc "[" sgr[name] "m", off, $1, $2, sgr[name]
        }'
    exit 0
fi

# Beside this script, wherever it was linked to, rather than on tmux's PATH.
rows=$("$(dirname "$0")/claude-sessions" --snapshot) || exit 0

changed=$(
    {
        printf '%s\n' "$palette" | awk -v t="$tab" '{print "C" t $1 t $2}'
        # Every window, so one whose last session just went can be cleared.
        tmux list-windows -a -F "W$tab#{window_id}$tab#{@claude_status}"
        [ -n "$rows" ] && printf '%s\n' "$rows" | awk '{print "S\t" $0}'
    } | awk -F"$tab" -v OFS="$tab" '
        BEGIN { mark = "▪" }

        $1 == "C" { colour[$2] = $3; next }

        $1 == "W" { win[$2]; current[$2] = $3; next }

        # S, then the eleven columns: status is 5, window_id is 8.
        $1 == "S" {
            state = $5
            if (!(state in colour)) state = "idle"
            marks[$8] = marks[$8] colour[state] mark
        }

        END {
            for (w in win) {
                text = (w in marks) ? marks[w] : ""
                if (text != current[w]) print w, text
            }
        }
    '
)

[ -n "$changed" ] || exit 0

printf '%s\n' "$changed" | while IFS="$tab" read -r win text; do
    if [ -n "$text" ]; then
        tmux set -w -t "$win" @claude_status "$text"
    else
        tmux set -uw -t "$win" @claude_status
    fi
done

tmux refresh-client -S
